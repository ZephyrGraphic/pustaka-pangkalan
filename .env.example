# Database Connection String (PostgreSQL — NeonDB / Supabase / VPS)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Secret untuk Autentikasi API (Ganti dengan string acak yang unik!)
JWT_SECRET="ganti-dengan-secret-key-acak-yang-aman"

# Node Environment
NODE_ENV="development"

# Server Port
PORT=3000
