# -----------------------------------------------------------------------------
# ENV Configuration - Perpustakaan Digital Desa Pangkalan Monorepo
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai
# -----------------------------------------------------------------------------

# Backend Next.js & REST API Configuration
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Database Configuration (PostgreSQL — gunakan NeonDB / Supabase / VPS)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Secret Key (Ganti dengan string random yang panjang & unik!)
JWT_SECRET="ganti-dengan-secret-key-acak-yang-aman"

# Mobile App Base API URL
# Android Emulator: http://10.0.2.2:3000/api/v1
# Production: https://your-domain.vercel.app/api/v1
FLUTTER_API_BASE_URL=http://10.0.2.2:3000/api/v1

